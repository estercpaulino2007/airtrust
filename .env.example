# Server
PORT=4000
JWT_SECRET=change-me-in-production
DEVICE_KEY=demo-device-key
TICK_MS=5000          # simulated sensor reading interval
BATCH_MS=30000        # Merkle batch anchoring interval
VERIFY_MIN_AGE_S=60   # an event must persist this long before it can be verified

# Blockchain (defaults to the local Hardhat node started by `npm start`)
RPC_URL=http://127.0.0.1:8545
# For Polygon Amoy testnet:
# RPC_URL=https://rpc-amoy.polygon.technology
# LEDGER_PRIVATE_KEY=0x...        # funded test wallet (never a real one)
# CONTRACT_ADDRESS=0x...          # from `npm run deploy:amoy`
# EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/
# AMOY_RPC_URL / DEPLOYER_PRIVATE_KEY are read by hardhat.config.js
